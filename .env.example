# pitwall-mcp — copia este fichero a .env y rellena los valores.
# El .env NUNCA se sube al repositorio (ver .gitignore).

# --- Credenciales BMW CarData ---------------------------------------------
# Client ID de la aplicación CarData creada en el portal BMW CarData.
# Es un UUID. Rellenar con el propio, aqui no hay ningun valor de ejemplo.
PITWALL_CLIENT_ID=

# --- Vehiculo --------------------------------------------------------------
# VIN del vehiculo (17 caracteres). Debe estar mapeado como PRIMARY.
PITWALL_VIN=

# --- Contenedor ------------------------------------------------------------
# ID del contenedor creado por scripts/bootstrap_containers.py.
# Se rellena DESPUES de ejecutar el script. El servidor MCP solo lo consume.
PITWALL_CONTAINER_ID=

# --- Rutas de estado local (fuera del repo) --------------------------------
# Fichero de tokens OAuth. Por defecto: ~/.config/pitwall-mcp/tokens.json
PITWALL_TOKEN_FILE=

# Base de datos SQLite. Por defecto: ~/.local/share/pitwall-mcp/pitwall.db
PITWALL_DB_PATH=

# --- Cuota -----------------------------------------------------------------
# Tope duro diario de peticiones REST. El limite real de BMW es 50/24h.
# Por defecto dejamos margen: 20.
PITWALL_DAILY_QUOTA=20

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. El transporte MCP es stdio: los logs van a stderr.
PITWALL_LOG_LEVEL=INFO
